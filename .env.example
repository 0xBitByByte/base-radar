# All variables below are optional — the app runs with zero environment
# variables set, using the defaults noted for each. None require secrets.

# Selects the active whale-detection provider. Only "blockscout" is
# implemented today; the other named values are reserved for future
# providers and will throw if set. Default: blockscout
# WHALE_PROVIDER=blockscout

# Selects the active governance data provider. Only "snapshot" is
# implemented today; the other named values are reserved for future
# providers and will throw if set. Default: snapshot
# GOVERNANCE_PROVIDER=snapshot

# Selects the active AI/rules intelligence provider. Only "rule-based" is
# implemented today; "openai" and "claude" are reserved for future
# providers and will throw if set. Default: rule-based
# INTELLIGENCE_PROVIDER=rule-based

# A GitHub personal access token with NO scopes selected (public-data-only
# read access). Raises the GitHub provider's rate limit from 60 req/hr
# (unauthenticated, shared across every visitor of this app) to 5,000 req/hr.
# Confirmed root cause of Engineering Health / Community Metrics / Evidence &
# Sources repeatedly showing "Unavailable" under normal testing traffic —
# create one at https://github.com/settings/tokens (classic, no scopes).
# Default: unset (60 req/hr, unauthenticated)
# GITHUB_TOKEN=

# CoinGecko Demo API key — sent as the `x-cg-demo-api-key` header on every
# CoinGecko request. Raises CoinGecko from its keyless path (an
# undocumented, unpublished ceiling) to the documented Demo tier (100
# req/min, 10,000 req/month). Get one free at
# https://www.coingecko.com/en/developers/dashboard. Default: unset
# (keyless requests, self-throttled to this app's own conservative
# in-process limit regardless).
# COINGECKO_API_KEY=

# Blockscout PRO API key — switches the Blockscout provider from the
# public per-chain host (base.blockscout.com, subject to bot-protection
# per Blockscout's own docs) to the authenticated PRO API
# (api.blockscout.com), sent as an `Authorization: Bearer` header. Get one
# free at https://dev.blockscout.com (free tier: 100K credits/day). Default:
# unset (calls the public base.blockscout.com host, unauthenticated).
# BLOCKSCOUT_API_KEY=

# WalletConnect Cloud (Reown) project id — required only for the
# WalletConnect connector to appear in the wallet connect menu. MetaMask and
# Coinbase Wallet work regardless, since neither needs this. Create one for
# free at https://cloud.reown.com. Default: unset (WalletConnect option
# hidden; MetaMask/Coinbase Wallet unaffected)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# File path for the Release 1 Phase C SQLite backend's database
# (`lib/backend/sqlite/`) — real, and now genuinely used by `/api/health`
# and every `/api/auth/*` route (challenge/verify/session/signout), even
# though `sqliteBackend` itself is still only registered, not activated,
# in `lib/backend/registry.ts`. Not a credential — a local file path, safe
# to leave unset for local dev (the default lives outside version control;
# `.data/` is gitignored, created automatically on first use).
#
# In the Fly.io staging deployment (`fly.toml`), this is set to
# `/data/backend.db` — `/data` is the mount point of a real, persistent
# Fly Volume, configured in `fly.toml`/the Dockerfile, never in this file.
# Default (local dev): <repo root>/.data/backend.db
# SQLITE_DB_PATH=

# Bug 3 (Authentication Flow) — comma-separated wallet addresses (any case;
# compared lowercased) that bootstrap into the ADMIN role the first time
# they sign in, before any explicit Role Management assignment exists for
# them (`lib/admin/authorization.ts`'s `isAdminAddress`/
# `resolveEffectiveRole`). Confirmed root cause of "Admin Login doesn't
# work" when unset: with no allowlist and no account yet holding a
# persisted `account_roles` row, EVERY signed-in account resolves to the
# real, unprivileged `USER` role, and every `/api/admin/*` route correctly,
# honestly returns 403 — not a bug in the authorization check itself, a
# real environment gap. Not a secret (these are public on-chain addresses,
# and the check they gate is itself server-side and re-verified on every
# request) — safe to commit, but every real deployment still needs its own
# real admin address(es) set. Default: unset (no bootstrap admin; every
# account starts as USER until Role Management assigns one)
# ADMIN_WALLET_ADDRESSES=
