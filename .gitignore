# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (PR-097.04) — real run output, never committed. Visual
# regression baseline images (`e2e/**/*-snapshots/`) are NOT covered by
# this and stay tracked — they're the reference the suite diffs against.
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# local SQLite backend database (Release 1 Phase C) — a real per-machine
# data file, never something to check in, same as any other local database
/.data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/settings.local.json
